<Window x:Class="ErGe.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ErGe Desktop"
        Width="720"
        Height="560"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ErGe Desktop"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Owner Control Center"
                       Margin="0,4,0,0"
                       FontSize="15"
                       Opacity="0.72" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24,0,0"
                Padding="18"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ALWAYS ON"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AlwaysOnDescription"
                               Margin="0,6,20,0"
                               TextWrapping="Wrap"
                               Text="Persistent remote availability is controlled by the local owner." />
                </StackPanel>

                <ToggleButton x:Name="AlwaysOnToggle"
                              Grid.Column="1"
                              Width="120"
                              Height="48"
                              VerticalAlignment="Center"
                              Content="OFF"
                              FontSize="18"
                              FontWeight="SemiBold"
                              Checked="AlwaysOnToggle_Checked"
                              Unchecked="AlwaysOnToggle_Unchecked" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="SYSTEM"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CoreStatusText"
                               Margin="0,8,0,0"
                               FontSize="17"
                               Text="Connecting..." />
                    <TextBlock x:Name="MachineText"
                               Margin="0,4,0,0"
                               Opacity="0.72" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="INTERACTIVE SESSION"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionStatusText"
                               Margin="0,8,0,0"
                               FontSize="17"
                               Text="Unknown" />
                    <TextBlock x:Name="AccessStatusText"
                               Margin="0,4,0,0"
                               Opacity="0.72" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="16"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="TEMPORARY OWNER CONTROLS"
                           FontSize="12"
                           FontWeight="SemiBold" />

                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="ConnectNowButton"
                            Margin="0,0,10,10"
                            Padding="18,9"
                            Content="Connect Now"
                            Click="ConnectNowButton_Click" />
                    <Button x:Name="LocalOnlyButton"
                            Margin="0,0,10,10"
                            Padding="18,9"
                            Content="Local Only"
                            Click="LocalOnlyButton_Click" />
                    <Button x:Name="EmergencyBlockButton"
                            Margin="0,0,10,10"
                            Padding="18,9"
                            Content="Emergency Block"
                            Click="EmergencyBlockButton_Click" />
                    <Button x:Name="ClearOverrideButton"
                            Margin="0,0,10,10"
                            Padding="18,9"
                            Content="Clear Override"
                            Click="ClearOverrideButton_Click" />
                </WrapPanel>

                <TextBlock x:Name="PolicyDetailText"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,18,0,0">
            <TextBlock Text="STATUS"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.78"
                       Text="Waiting for Core..." />
        </StackPanel>

        <Grid Grid.Row="5"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Opacity="0.62"
                       Text="Owner policy is enforced by ErGe Core, not by the UI." />

            <Button Grid.Column="1"
                    Padding="18,8"
                    Content="Refresh"
                    Click="RefreshButton_Click" />
        </Grid>
    </Grid>
</Window>
